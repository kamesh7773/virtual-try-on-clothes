# Copy to .env.development, .env.staging and .env.production, then set values per flavor.
# Read by lib/core/config/env.dart.

# Required. Host for every endpoint in ApiEndpoints (trailing slash is stripped).
API_BASE_URL=https://mirror.maxaix.com

# Switches: only the exact lowercase value `true` turns one on.
ENABLE_LOGS=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
